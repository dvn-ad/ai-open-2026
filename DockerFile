# 1. Use an official Python runtime as a parent image (matches the local environment)
FROM python:3.12-slim

# 2. Set environment variables to optimize Python execution in containers
ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_NO_CACHE_DIR=1

# 3. Install critical system dependencies required by OpenCV and PaddleOCR
# - libgl1 and libglib2.0-0 are required for OpenCV headless execution
# - libgomp1 is required for multi-threaded openMP mathematical runtimes (e.g. Paddle/PyTorch)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libgl1 \
    libglib2.0-0 \
    libgomp1 \
    && rm -rf /var/lib/apt/lists/*

# 4. Set the working directory inside the container
WORKDIR /app

# 5. Copy requirements first to leverage Docker's layer caching
COPY requirements.txt .

# 6. Upgrade core pip utilities and install dependencies
RUN pip install --no-cache-dir -U pip setuptools wheel && \
    pip install --no-cache-dir -r requirements.txt

# 7. Copy the rest of the application files (ignoring files specified in .dockerignore)
COPY . .

# 8. Set the default command to run the pipeline
CMD ["python", "src/main.py"]